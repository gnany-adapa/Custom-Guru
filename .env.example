# ---------------------------------------------------------------------------
# Custom Guru — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Which LLM provider adapter to use: hyperspace | (openai, claude, gemini later)
LLM_PROVIDER=hyperspace

# --- Hyperspace local proxy ---
HYPERSPACE_BASE_URL=http://localhost:6655
HYPERSPACE_API_KEY=your-hyperspace-api-key-here
HYPERSPACE_LLM_MODEL=claude-sonnet-4-6
HYPERSPACE_EMBED_MODEL=text-embedding-3-large

# --- Persona + RAG settings ---
# The demo ships persona-neutral. Point these at your own corpus and set the display
# identity below. `PERSONA` is the collection/data key; identity is what the UI shows.
PERSONA=example
TRANSCRIPTS_DIR=data/personas/example/transcripts
PERSONA_NAME=Example Mentor
PERSONA_INITIALS=EM
PERSONA_ROLE=Grounded in their own words
CHROMA_DIR=data/chroma
TOP_K=4
# Max cosine DISTANCE (0 = identical, 2 = opposite) for the nearest chunk to count as
# "covered". Above it, the engine reasons from principles or declines instead of guessing.
# Calibrate with `python -m backend.app.eval.runner`; denser corpora can go lower.
SIMILARITY_THRESHOLD=0.60
# Max cosine DISTANCE for the nearest *principle* to be relevant enough to reason from.
# Above it, the engine declines instead of extrapolating. Calibrated so novel on-domain
# questions (~0.55-0.75) reason while off-topic (~0.81+) declines; re-run the eval to tune.
REASONING_THRESHOLD=0.78
# When true, reasoned answers are checked against principles; unfaithful claims are flagged.
CRITIC_ENABLED=true

# --- Frontend ---
# Where the Streamlit UI finds the backend API.
BACKEND_URL=http://localhost:8000

# --- Observability (optional) ---
# Leave blank to disable. Self-host Langfuse or use their cloud; keys from Project Settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
